rules_version = '2';

// Live rules for Cloud Storage. Deploy with:
//   npx firebase-tools deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fejzula.florent@hotmail.com';
    }

    // Place and recipe photos are public to read, admin-only to write.
    match /places/{placeId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /recipes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
