rules_version = '2';

// PROPOSAL — not deployed yet, and deliberately not wired into firebase.json.
//
// Before deploying:
//   1. Copy the rules currently live in the Firebase console and diff them
//      against this file — nobody here can read them, so this is written from
//      what the app does, not from what is live.
//   2. Add to firebase.json:
//        "firestore": { "rules": "firestore.rules" }
//   3. Test in the console's Rules Playground, then:
//        npx firebase-tools deploy --only firestore:rules
//
// A wrong rule here breaks reads for every visitor, so it deploys on its own,
// never bundled with a hosting deploy.

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin account. Swap for `request.auth.uid == '<uid>'` if the email
    // check ever gets in the way — the uid is in Firebase console > Auth.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fejzula.florent@hotmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public catalog: anyone can browse without an account, only admin writes.
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A user owns their own document (favorites live here).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
