rules_version = '2';

// Live rules for Firestore. Deploy on their own, never bundled with hosting:
//   npx firebase-tools deploy --only firestore:rules
//
// A wrong rule here breaks reads for every visitor, so after deploying, check
// that an unauthenticated read of /places still returns documents.

service cloud.firestore {
  match /databases/{database}/documents {

    // The admin account. Swap for `request.auth.uid == '<uid>'` if the email
    // check ever gets in the way — the uid is in Firebase console > Auth.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fejzula.florent@hotmail.com';
    }

    // Public catalog: anyone can browse without an account, only admin writes.
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Recipes are a personal tool, not part of the public product.
    match /recipes/{recipeId} {
      allow read, write: if isAdmin();
    }

    // A user owns their own document (favorites live here).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
